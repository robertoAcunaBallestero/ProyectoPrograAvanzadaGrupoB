@model Proyecto_Progra_Grupo8.Entidades.Models.Orden

@{
    ViewBag.Title = "Detalle de la orden";
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h1>Detalle de la orden</h1>
        <p class="text-muted">
            Información de su compra y tickets generados.
        </p>
    </div>

    <div class="card mb-4">

        <div class="card-body">

            <h4 class="card-title">
                Orden #@Model.OrdenId
            </h4>

            <p>
                <strong>Fecha de compra:</strong>
                @Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <strong>Total:</strong>
                ₡@Model.Total.ToString("N2")
            </p>

        </div>

    </div>

    <h3 class="mb-3">Entradas compradas</h3>

    @foreach (var detalle in Model.Detalles)
    {
        <div class="card mb-3">

            <div class="card-body">

                <h4>
                    @detalle.Evento.Nombre
                </h4>

                <p>
                    <strong>Fecha del evento:</strong>
                    @detalle.Evento.FechaHora.ToString("dd/MM/yyyy HH:mm")
                </p>

                <p>
                    <strong>Lugar:</strong>
                    @detalle.Evento.Lugar
                </p>

                <p>
                    <strong>Cantidad:</strong>
                    @detalle.Cantidad
                </p>

                <p>
                    <strong>Precio por entrada:</strong>
                    ₡@detalle.PrecioUnitario.ToString("N2")
                </p>

                <p>
                    <strong>Subtotal:</strong>
                    ₡@((detalle.Cantidad * detalle.PrecioUnitario).ToString("N2"))
                </p>

                <hr />

                <h5>Tickets</h5>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead>
                            <tr>
                                <th>Ticket</th>
                                <th>Código único</th>
                                <th>Fecha de generación</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var ticket in detalle.Tickets)
                            {
                                <tr>
                                    <td>
                                        @ticket.TicketId
                                    </td>

                                    <td>
                                        @ticket.CodigoUnico
                                    </td>

                                    <td>
                                        @ticket.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @*<a href="@Url.Action("Detalle", "Tickets", new { id = ticket.TicketId })"
                                             class="btn btn-primary btn-sm">
                                              <i class="fa-solid fa-ticket"></i>
                                              Ver ticket
                                          </a>*@
                                        <a href="@Url.Action("Detalle", "Tickets", new {id = ticket.TicketId, ordenId = detalle.OrdenId})"
                                           class="btn btn-primary btn-sm">
                                            <i class="fa-solid fa-ticket"></i>
                                            Ver ticket
                                        </a>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

    <div class="mt-4">

        @Html.ActionLink(
            "Volver al historial",
            "Index",
            "Ordenes",
            null,
            new { @class = "btn btn-secondary" }
        )

    </div>

</div>




