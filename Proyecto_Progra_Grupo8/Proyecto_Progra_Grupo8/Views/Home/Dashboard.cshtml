@{
    ViewBag.Title = "Dashboard";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                Dashboard Administrativo
            </h2>

            <p class="text-muted mb-0">
                Resumen general de la actividad de la plataforma.
            </p>
        </div>

        @Html.ActionLink(
                 "Volver al panel",
                 "Panel",
                 "Home",
                 null,
                 new
                 {
                     @class = "btn btn-secondary"
                 })

    </div>

    <div id="dashboardSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="text-muted mt-2">Cargando estadísticas...</p>
    </div>

    <div id="dashboardError" class="alert alert-danger d-none"></div>

    <div id="dashboardContenido" class="d-none">

        <div class="row g-4 mb-4">

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Usuarios registrados</p>
                                <h2 class="fw-bold mb-0" id="totalUsuarios">0</h2>
                            </div>
                            <div class="fs-1 text-primary">
                                <i class="fa-solid fa-users"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Eventos activos</p>
                                <h2 class="fw-bold mb-0" id="totalEventosActivos">0</h2>
                            </div>
                            <div class="fs-1 text-success">
                                <i class="fa-solid fa-calendar-check"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Eventos próximos</p>
                                <h2 class="fw-bold mb-0" id="totalEventosProximos">0</h2>
                            </div>
                            <div class="fs-1 text-info">
                                <i class="fa-solid fa-calendar-days"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Órdenes realizadas</p>
                                <h2 class="fw-bold mb-0" id="totalOrdenes">0</h2>
                            </div>
                            <div class="fs-1 text-warning">
                                <i class="fa-solid fa-receipt"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Entradas vendidas</p>
                                <h2 class="fw-bold mb-0" id="entradasVendidas">0</h2>
                            </div>
                            <div class="fs-1 text-danger">
                                <i class="fa-solid fa-ticket"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Ingresos totales</p>
                                <h2 class="fw-bold mb-0" id="ingresosTotales">₡0.00</h2>
                            </div>
                            <div class="fs-1 text-success">
                                <i class="fa-solid fa-coins"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="row g-4">

            <div class="col-12 col-lg-7">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Ingresos por evento</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="graficoIngresos" style="max-height: 350px;"></canvas>
                        <div id="graficoVacio" class="alert alert-info mb-0 d-none">
                            Todavía no existen ventas para mostrar en el gráfico.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Eventos con bajo aforo</h5>
                    </div>
                    <div class="card-body">

                        <div id="bajoAforoVacio" class="alert alert-success mb-0 d-none">
                            No hay eventos próximos a agotarse.
                        </div>

                        <div id="bajoAforoTabla" class="table-responsive d-none">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Evento</th>
                                        <th class="text-center">Disponibles</th>
                                    </tr>
                                </thead>
                                <tbody id="bajoAforoBody"></tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>

        </div>

    </div>

</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/Scripts/app/dashboard.js"></script>
}
