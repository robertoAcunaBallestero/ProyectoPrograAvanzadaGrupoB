@{
    ViewBag.Title = "Inicio";
}

<main>
    <section class="row" aria-labelledby="title">
        <h1 id="title">Cooperativa</h1>
        <p class="lead">Sistema de gestión de asociados de la cooperativa.</p>
        @if (!Request.IsAuthenticated)
        {
            <p>
                @Html.ActionLink("Iniciar sesión", "Login", "Account", null, new { @class = "btn btn-outline-dark" })
                @Html.ActionLink("Registrarse", "Register", "Account", null, new { @class = "btn btn-primary" })
            </p>
        }
        else
        {
            <p>@Html.ActionLink("Ir a mi panel", "Panel", "Home", null, new { @class = "btn btn-primary" })</p>
        }
    </section>
</main>
