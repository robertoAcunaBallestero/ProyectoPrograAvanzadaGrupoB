@{
    ViewBag.Title = "Inicio";
}

<!-- Carga de Font Awesome para los íconos -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .hero-section {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
        border-radius: 1.5rem;
        padding: 4rem 2rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }

    .btn-hero-primary {
        background-color: #ffffff;
        color: #1e3c72;
        font-weight: 600;
        padding: 0.8rem 1.8rem;
        border-radius: 0.5rem;
        border: none;
        transition: all 0.3s ease;
    }

    .btn-hero-primary:hover {
        background-color: #f8f9fa;
        color: #2a5298;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 255, 255, 0.2);
    }

    .btn-hero-outline {
        border: 2px solid rgba(255, 255, 255, 0.8);
        color: white;
        font-weight: 600;
        padding: 0.8rem 1.8rem;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .btn-hero-outline:hover {
        background-color: rgba(255, 255, 255, 0.1);
        color: white;
        border-color: white;
        transform: translateY(-2px);
    }

    .feature-card {
        border: none;
        border-radius: 1rem;
        transition: all 0.3s ease;
        background: #ffffff;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }

    .feature-icon {
        width: 60px;
        height: 60px;
        background: rgba(30, 60, 114, 0.1);
        color: #1e3c72;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }
</style>

<main class="container my-5">
    <!-- Seccion Hero / Banner Principal -->
    <section class="hero-section text-center my-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="mb-3">
                    <i class="fa-solid fa-building-columns fa-4x text-white-50"></i>
                </div>
                <h1 class="display-4 fw-bold mb-3">Cooperativa</h1>
                <p class="lead text-white-50 mb-4">
                    Plataforma integral para la gestión, servicios y trámites de nuestros asociados.
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    @if (!Request.IsAuthenticated)
                    {
                        @Html.ActionLink("Iniciar Sesión", "Login", "Account", null, new { @class = "btn btn-hero-primary shadow-sm" })
                        @Html.ActionLink("Registrarse", "Register", "Account", null, new { @class = "btn btn-hero-outline" })
                    }
                    else
                    {
                        <a href="@Url.Action("Panel", "Home")" class="btn btn-hero-primary shadow-sm">
                            <i class="fa-solid fa-gauge-high me-2"></i>Ir a mi Panel
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Tarjetas Informativas / Accesos Rápidos -->
    <section class="row g-4 mt-2">
        @*<div class="col-md-4">
            <div class="card feature-card h-100 p-4 shadow-sm">
                <div class="card-body text-center d-flex flex-column align-items-center">
