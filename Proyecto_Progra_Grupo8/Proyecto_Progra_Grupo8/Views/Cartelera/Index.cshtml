@model IEnumerable<Proyecto_Progra_Grupo8.Entidades.Models.Evento>

@{
    ViewBag.Title = "Cartelera";
}

<div class="container py-4">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Cartelera de Eventos</h1>
        <p class="text-muted">
            Descubre nuestros próximos eventos y reserva tus entradas.
        </p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var evento in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body d-flex flex-column">

                            <h4 class="card-title">
                                @evento.Nombre
                            </h4>

                            <p class="text-muted mb-2">
                                @evento.CategoriaEventoId
                            </p>

                            <p class="card-text">
                                @evento.Descripcion
                            </p>

                            <div class="mt-auto">

                                <p class="mb-1">
                                    <strong>Fecha:</strong>
                                    @evento.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                </p>

                                <p class="mb-1">
                                    <strong>Lugar:</strong>
                                    @evento.Lugar
                                </p>

                                <p class="mb-1">
                                    <strong>Precio:</strong>
                                    ₡@evento.PrecioEntrada.ToString("N2")
                                </p>

                                <p class="mb-3">
                                    <strong>Entradas disponibles:</strong>
                                    @evento.EntradasDisponibles
                                </p>

                                <div class="d-grid">

                                    @Html.ActionLink(
                                        "Ver detalles",
                                        "Detalle",
                                        "Cartelera",
                                        new { id = evento.EventoId },
                                        new { @class = "btn btn-primary" }
                                    )

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            Actualmente no hay eventos disponibles.
        </div>
    }

</div>




