@model Proyecto_Progra_Grupo8.Entidades.Models.Evento

@{
    ViewBag.Title = "Detalle del evento";
}

<div class="container mt-4">

    <div class="row">

        <div class="col-md-8 offset-md-2">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h1 class="card-title mb-4">
                        @Model.Nombre
                    </h1>

                    <p class="text-muted">
                        @Model.Descripcion
                    </p>

                    <hr />

                    <div class="mb-3">
                        <strong>Código del evento:</strong>
                        @Model.CodigoEvento
                    </div>

                    <div class="mb-3">
                        <strong>Fecha:</strong>
                        @Model.FechaHora.ToString("dd/MM/yyyy HH:mm")
                    </div>

                    <div class="mb-3">
                        <strong>Lugar:</strong>
                        @Model.Lugar
                    </div>

                    <div class="mb-3">
                        <strong>Precio por entrada:</strong>
                        ₡@Model.PrecioEntrada.ToString("N2")
                    </div>

                    <div class="mb-3">
                        <strong>Aforo total:</strong>
                        @Model.AforoTotal
                    </div>

                    <div class="mb-4">
                        <strong>Entradas disponibles:</strong>
                        @Model.EntradasDisponibles
                    </div>

                    @*<div class="d-flex gap-2">

            @Html.ActionLink(
                "Volver a la cartelera",
                "Index",
                "Cartelera",
                null,
                new { @class = "btn btn-secondary" }
            )

        </div>*@

                    <div class="mt-4">

                        @if (User.Identity.IsAuthenticated && User.IsInRole("Asociado"))
                        {
                            if (Model.EntradasDisponibles > 0)
                            {
                                using (Html.BeginForm("Agregar", "Carrito", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    @Html.Hidden("EventoId", Model.EventoId)

                                    <div class="mb-3">
                                        <label for="Cantidad" class="form-label">
                                            Cantidad de entradas
                                        </label>

                                        <input type="number"
                                               id="Cantidad"
                                               name="Cantidad"
                                               class="form-control"
                                               min="1"
                                               max="@Model.EntradasDisponibles"
                                               value="1"
                                               required />
                                    </div>

                                    <button type="submit" class="btn btn-primary">
                                        Agregar al carrito
                                    </button>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    Este evento no tiene entradas disponibles.
                                </div>
                            }
                        }
                        else if (!User.Identity.IsAuthenticated)
                        {
                            <div class="alert alert-info">
                                Debes iniciar sesión como Asociado para comprar entradas.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                Solo los Asociados pueden comprar entradas.
                            </div>
                        }

                        @Html.ActionLink(
                            "Volver a la cartelera",
                            "Index",
                            "Cartelera",
                            null,
                            new { @class = "btn btn-secondary mt-2" }
                        )

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>




