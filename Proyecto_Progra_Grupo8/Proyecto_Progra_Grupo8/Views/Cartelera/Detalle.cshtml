<style>
    .evento-galeria {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 25px;
    }

    .evento-imagen {
        height: 220px;
        overflow: hidden;
        border-radius: 12px;
        background: #f1f1f1;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.10);
    }

        .evento-imagen img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    @@media (max-width: 768px) {
        .evento-galeria {
            grid-template-columns: 1fr;
        }

        .evento-imagen {
            height: 250px;
        }
    }
</style>

@section scripts {
    <script src="~/Scripts/app/carrito.js"></script>
}