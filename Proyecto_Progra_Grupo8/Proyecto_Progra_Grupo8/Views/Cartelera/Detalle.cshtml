@model Proyecto_Progra_Grupo8.Entidades.Models.Evento

@using System.Linq
@using Proyecto_Progra_Grupo8.Entidades.Models

@{
    ViewBag.Title = "Detalle del evento";

    var resenas =
        ViewBag.Resenas as IEnumerable<Resena>;
}

<div class="container mt-4">

    <div class="row">

        <div class="col-md-8 offset-md-2">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h1 class="card-title mb-4">
                        @Model.Nombre
                    </h1>

                    <p class="text-muted">
                        @Model.Descripcion
                    </p>

                    <hr />

                    <div class="mb-3">
                        <strong>Código del evento:</strong>
                        @Model.CodigoEvento
                    </div>

                    <div class="mb-3">
                        <strong>Fecha:</strong>
                        @Model.FechaHora.ToString("dd/MM/yyyy HH:mm")
                    </div>

                    <div class="mb-3">
                        <strong>Lugar:</strong>
                        @Model.Lugar
                    </div>

                    <div class="mb-3">
                        <strong>Precio por entrada:</strong>
                        ₡@Model.PrecioEntrada.ToString("N2")
                    </div>

                    <div class="mb-3">
                        <strong>Aforo total:</strong>
                        @Model.AforoTotal
                    </div>

                    <div class="mb-4">
                        <strong>Entradas disponibles:</strong>
                        @Model.EntradasDisponibles
                    </div>

                    <div class="mt-4">

                        @if (User.Identity.IsAuthenticated &&
                             User.IsInRole("Asociado"))
                        {
                            if (Model.EntradasDisponibles > 0)
                            {
                                using (Html.BeginForm(
                                    "Agregar",
                                    "Carrito",
                                    FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    @Html.Hidden(
                                        "EventoId",
                                        Model.EventoId)

                                    <div class="mb-3">

                                        <label for="Cantidad"
                                               class="form-label">
                                            Cantidad de entradas
                                        </label>

                                        <input type="number"
                                               id="Cantidad"
                                               name="Cantidad"
                                               class="form-control"
                                               min="1"
                                               max="@Model.EntradasDisponibles"
                                               value="1"
                                               required />

                                    </div>

                                    <button type="submit"
                                            class="btn btn-primary">
                                        Agregar al carrito
                                    </button>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    Este evento no tiene entradas disponibles.
                                </div>
                            }
                        }
                        else if (!User.Identity.IsAuthenticated)
                        {
                            <div class="alert alert-info">
                                Debes iniciar sesión como Asociado para comprar entradas.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                Solo los Asociados pueden comprar entradas.
                            </div>
                        }

                        @Html.ActionLink(
                            "Volver a la cartelera",
                            "Index",
                            "Cartelera",
                            null,
                            new
                            {
                                @class = "btn btn-secondary mt-2"
                            })

                    </div>

                </div>

            </div>

            <div class="card shadow-sm mt-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h3 class="mb-0">
                            Reseñas
                        </h3>

                        @if (User.Identity.IsAuthenticated &&
                             User.IsInRole("Asociado"))
                        {
                            @Html.ActionLink(
                                "Escribir reseña",
                                "Crear",
                                "Resenas",
                                new
                                {
                                    eventoId = Model.EventoId
                                },
                                new
                                {
                                    @class = "btn btn-outline-primary"
                                })
                        }

                    </div>

                    <hr />

                    @if (resenas == null || !resenas.Any())
                    {
                        <div class="alert alert-light border">
                            Este evento todavía no tiene reseñas publicadas.
                        </div>
                    }
                    else
                    {
                        foreach (var resena in resenas)
                        {
                            <div class="border rounded p-3 mb-3">

                                <div class="d-flex justify-content-between">

                                    <strong>
                                        @if (resena.Usuario != null)
                                        {
                                            @resena.Usuario.NombreCompleto
                                        }
                                        else
                                        {
                                            @:Asociado
                                        }
                                    </strong>

                                    <small class="text-muted">
                                        @resena.FechaResena.ToString("dd/MM/yyyy")
                                    </small>

                                </div>

                                <p class="mt-2 mb-0">
                                    @resena.Comentario
                                </p>

                            </div>
                        }
                    }

                </div>

            </div>

        </div>

    </div>

</div>