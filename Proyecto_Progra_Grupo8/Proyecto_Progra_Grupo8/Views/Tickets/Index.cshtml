@using System.Linq
@using Proyecto_Progra_Grupo8.Entidades.Models

@model IEnumerable<Orden>

@{
    ViewBag.Title = "Mis Tickets";
} 

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container my-4">

    <div class="text-center mb-4">
        <h2 class="fw-bold">Mis Tickets</h2>
        <p class="text-muted">
            Consulta los tickets de tus compras y accede a cada entrada.
        </p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Todavía no tienes tickets generados.
        </div>

        <a href="@Url.Action("Index", "Eventos")"
           class="btn btn-secondary">
            Volver a la cartelera
        </a>
    }
    else
    {
        foreach (var orden in Model)
        {
            <div class="mb-5">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0">
                        Orden #@orden.OrdenId
                    </h4>

                    <span class="text-muted">
                        Compra:
                        @orden.FechaCompra.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div class="row g-4">

                    @foreach (var detalle in orden.Detalles)
                    {
                        foreach (var ticket in detalle.Tickets)
                        {
                            <div class="col-12 col-md-6 col-lg-4">

                                <div class="card h-100 shadow-sm border-0 ticket-card">

                                    <div class="card-body p-4">

                                        <div class="d-flex justify-content-between align-items-center mb-3">

                                            <div class="ticket-icon">
                                                <i class="fa-solid fa-ticket"></i>
                                            </div>

                                            <span class="badge bg-primary">
                                                Ticket
                                            </span>

                                        </div>

                                        <h5 class="fw-bold">
                                            @detalle.Evento.Nombre
                                        </h5>

                                        <hr />

                                        <p class="mb-2">
                                            <strong>Fecha:</strong>
                                            @detalle.Evento.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                        </p>

                                        <p class="mb-2">
                                            <strong>Lugar:</strong>
                                            @detalle.Evento.Lugar
                                        </p>

                                        <p class="mb-2">
                                            <strong>Código único:</strong>
                                        </p>

                                        <div class="codigo-ticket mb-3">
                                            @ticket.CodigoUnico
                                        </div>

                                        <p class="text-muted small mb-4">
                                            Generado:
                                            @ticket.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")
                                        </p>

                                        <a href="@Url.Action("Detalle", "Tickets", new { id = ticket.TicketId })"
                                           class="btn btn-primary w-100">
                                            <i class="fa-solid fa-eye me-2"></i>
                                            Ver ticket
                                        </a>

                                    </div>

                                </div>

                            </div>
                        }
                    }

                </div>

            </div>
        }
    }

</div> 

<div class="text-center mt-4 mb-4">
    <a href="@Url.Action("Panel", "Home")"
       class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left me-2"></i>
        Volver al panel
    </a>
</div>

<style>

    .ticket-card {
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .ticket-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12) !important;
        }

    .ticket-icon {
        width: 50px;
        height: 50px;
        border-radius: 0.75rem;
        background-color: #e8f0ff;
        color: #1e3c72;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
    }

    .codigo-ticket {
        padding: 0.75rem;
        background-color: #f5f5f5;
        border-radius: 0.5rem;
        font-family: monospace;
        font-size: 0.85rem;
        word-break: break-all;
    }
</style>
