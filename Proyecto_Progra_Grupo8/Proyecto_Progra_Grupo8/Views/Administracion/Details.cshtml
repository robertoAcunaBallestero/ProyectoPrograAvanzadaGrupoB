@model Proyecto_Progra_Grupo8.Entidades.Models.ApplicationUser

@{
    ViewBag.Title = "Detalles del usuario";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h3 class="mb-0">
                        Detalles del usuario
                    </h3>
                </div>

                <div class="card-body">

                    <dl class="row">

                        <dt class="col-sm-4">
                            Nombre completo
                        </dt>
                        <dd class="col-sm-8">
                            @Model.NombreCompleto
                        </dd>

                        <dt class="col-sm-4">
                            Cédula
                        </dt>
                        <dd class="col-sm-8">
                            @Model.Cedula
                        </dd>

                        <dt class="col-sm-4">
                            Correo electrónico
                        </dt>
                        <dd class="col-sm-8">
                            @Model.Email
                        </dd>

                        <dt class="col-sm-4">
                            Número de asociado
                        </dt>
                        <dd class="col-sm-8">
                            @Model.NumeroAsociado
                        </dd>

                        <dt class="col-sm-4">
                            Fecha de nacimiento
                        </dt>
                        <dd class="col-sm-8">
                            @Model.FechaNacimiento.ToString("dd/MM/yyyy")
                        </dd>

                        <dt class="col-sm-4">
                            Fecha de ingreso
                        </dt>
                        <dd class="col-sm-8">
                            @Model.FechaIngreso.ToString("dd/MM/yyyy HH:mm")
                        </dd>

                        <dt class="col-sm-4">
                            Rol
                        </dt>
                        <dd class="col-sm-8">
                            @ViewBag.Rol
                        </dd>

                        <dt class="col-sm-4">
                            Estado
                        </dt>
                        <dd class="col-sm-8">

                            @if (Model.Activo)
                            {
                                <span class="badge bg-success">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactivo
                                </span>
                            }

                        </dd>

                        <dt class="col-sm-4">
                            Última conexión
                        </dt>
                        <dd class="col-sm-8">

                            @if (Model.UltimaConexion.HasValue)
                            {
                                @Model.UltimaConexion.Value.ToString(
                                    "dd/MM/yyyy HH:mm:ss")
                            }
                            else
                            {
                                <span class="text-muted">
                                    Nunca ha iniciado sesión
                                </span>
                            }

                        </dd>

                    </dl>

                </div>

                <div class="card-footer">

                    @Html.ActionLink(
                        "Editar",
                        "Edit",
                        new { id = Model.Id },
                        new { @class = "btn btn-primary" })

                    @Html.ActionLink(
                        "Volver",
                        "Index",
                        null,
                        new { @class = "btn btn-secondary ms-2" })

                </div>

            </div>

        </div>
    </div>

</div>