@model Proyecto_Progra_Grupo8.Entidades.Models.ApplicationUser

@{
    ViewBag.Title = "Detalle del usuario";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">

                    <h4 class="mb-0">
                        Detalle del usuario
                    </h4>

                </div>

                <div class="card-body">

                    <dl class="row">

                        <dt class="col-sm-4">
                            Nombre completo
                        </dt>

                        <dd class="col-sm-8">
                            @Model.NombreCompleto
                        </dd>

                        <dt class="col-sm-4">
                            Cédula
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Cedula
                        </dd>

                        <dt class="col-sm-4">
                            Correo electrónico
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Email
                        </dd>

                        <dt class="col-sm-4">
                            Número de asociado
                        </dt>

                        <dd class="col-sm-8">
                            @Model.NumeroAsociado
                        </dd>

                        <dt class="col-sm-4">
                            Fecha de nacimiento
                        </dt>

                        <dd class="col-sm-8">
                            @Model.FechaNacimiento.ToString("dd/MM/yyyy")
                        </dd>

                        <dt class="col-sm-4">
                            Fecha de ingreso
                        </dt>

                        <dd class="col-sm-8">
                            @Model.FechaIngreso.ToString("dd/MM/yyyy")
                        </dd>

                        <dt class="col-sm-4">
                            Rol
                        </dt>

                        <dd class="col-sm-8">
                            @ViewBag.Rol
                        </dd>

                    </dl>

                    <hr />

                    <div class="d-flex justify-content-end gap-2">

                        @Html.ActionLink(
                            "Volver",
                            "Index",
                            "Administracion",
                            null,
                            new
                            {
                                @class = "btn btn-secondary"
                            })

                        @Html.ActionLink(
                            "Editar",
                            "Edit",
                            "Administracion",
                            new
                            {
                                id = Model.Id
                            },
                            new
                            {
                                @class = "btn btn-primary"
                            })

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
