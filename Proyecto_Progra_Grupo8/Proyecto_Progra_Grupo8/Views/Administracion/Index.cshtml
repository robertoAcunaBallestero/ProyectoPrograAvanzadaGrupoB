@model IEnumerable<Proyecto_Progra_Grupo8.Entidades.Models.ApplicationUser>

@{
    ViewBag.Title = "Asociados";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Usuarios registrados</h2>
            <p class="text-muted mb-0">
                Administración de usuarios del sistema.
            </p>
        </div>

        @Html.ActionLink(
            "Crear usuario",
            "Create",
            "Administracion",
            null,
            new
            {
                @class = "btn btn-primary"
            })
    </div>

    <hr />

    @Html.Partial("_Mensajes")

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay usuarios registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Número de asociado</th>
                        <th>Nombre completo</th>
                        <th>Cédula</th>
                        <th>Correo</th>
                        <th>Fecha de ingreso</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var asociado in Model)
                    {
                        <tr>

                            <td>
                                @asociado.NumeroAsociado
                            </td>

                            <td>
                                @asociado.NombreCompleto
                            </td>

                            <td>
                                @asociado.Cedula
                            </td>

                            <td>
                                @asociado.Email
                            </td>

                            <td>
                                @asociado.FechaIngreso.ToShortDateString()
                            </td>

                            <td class="text-center">

                                <div class="d-flex justify-content-center gap-1">

                                    @Html.ActionLink(
                                        "Detalle",
                                        "Details",
                                        new
                                        {
                                            id = asociado.Id
                                        },
                                        new
                                        {
                                            @class = "btn btn-info btn-sm text-white"
                                        })

                                    @Html.ActionLink(
                                        "Editar",
                                        "Edit",
                                        new
                                        {
                                            id = asociado.Id
                                        },
                                        new
                                        {
                                            @class = "btn btn-warning btn-sm"
                                        })

                                    @Html.ActionLink(
                                        "Eliminar",
                                        "Delete",
                                        new
                                        {
                                            id = asociado.Id
                                        },
                                        new
                                        {
                                            @class = "btn btn-danger btn-sm"
                                        })

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <div class="mt-3">

        @Html.ActionLink(
            "Volver al panel",
            "Panel",
            "Home",
            null,
            new
            {
                @class = "btn btn-secondary"
            })

    </div>

</div>