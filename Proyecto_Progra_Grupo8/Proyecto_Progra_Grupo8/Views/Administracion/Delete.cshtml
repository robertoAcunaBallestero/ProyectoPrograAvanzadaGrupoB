@model Proyecto_Progra_Grupo8.Entidades.Models.ApplicationUser

@{
    ViewBag.Title = "Eliminar usuario";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm border-danger">

                <div class="card-header bg-danger text-white">

                    <h4 class="mb-0">
                        Eliminar usuario
                    </h4>

                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        ¿Está seguro de que desea eliminar este usuario?
                        Esta acción no se puede deshacer.
                    </div>

                    <dl class="row">

                        <dt class="col-sm-4">
                            Nombre completo
                        </dt>

                        <dd class="col-sm-8">
                            @Model.NombreCompleto
                        </dd>

                        <dt class="col-sm-4">
                            Cédula
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Cedula
                        </dd>

                        <dt class="col-sm-4">
                            Correo electrónico
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Email
                        </dd>

                        <dt class="col-sm-4">
                            Número de asociado
                        </dt>

                        <dd class="col-sm-8">
                            @Model.NumeroAsociado
                        </dd>

                        <dt class="col-sm-4">
                            Fecha de ingreso
                        </dt>

                        <dd class="col-sm-8">
                            @Model.FechaIngreso.ToString("dd/MM/yyyy")
                        </dd>

                        <dt class="col-sm-4">
                            Rol
                        </dt>

                        <dd class="col-sm-8">
                            @ViewBag.Rol
                        </dd>

                    </dl>

                    <hr />

                    @using (Html.BeginForm(
                        "Delete",
                        "Administracion",
                        new
                        {
                            id = Model.Id
                        },
                        FormMethod.Post,
                        null))
                    {
                        @Html.AntiForgeryToken()

                        <div class="d-flex justify-content-end gap-2">

                            @Html.ActionLink(
                                "Cancelar",
                                "Index",
                                "Administracion",
                                null,
                                new
                                {
                                    @class = "btn btn-secondary"
                                })

                            <button type="submit"
                                    class="btn btn-danger">
                                Eliminar usuario
                            </button>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
