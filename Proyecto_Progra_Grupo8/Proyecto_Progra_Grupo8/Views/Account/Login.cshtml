@using Proyecto_Progra_Grupo8.Models
@model LoginViewModel
@{
    ViewBag.Title = "Iniciar Sesión";
}

<!-- Carga de Font Awesome para los íconos de los campos -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .login-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        background: #ffffff;
    }

    .login-header {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
        padding: 2.5rem 2rem;
        text-align: center;
    }

    .form-floating > .form-control:focus ~ label {
        color: #1e3c72;
    }

    .btn-login {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        border: none;
        color: white;
        padding: 0.8rem;
        font-weight: 600;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .btn-login:hover {
        background: linear-gradient(135deg, #2a5298 0%, #1e3c72 100%);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(30, 60, 114, 0.3);
    }

    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
    }

    .form-control-with-icon {
        border-left: none;
    }

    .form-control:focus {
        border-color: #1e3c72;
        box-shadow: none;
    }
</style>

<div class="container login-container my-4">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
            <div class="card login-card">
                
                <!-- Encabezado con degradado e ícono -->
                <div class="login-header">
                    <div class="mb-3">
                        <i class="fa-solid fa-user-circle fa-4x"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Bienvenido</h3>
                    <p class="mb-0 text-white-50">Ingresa tus credenciales para acceder</p>
                </div>

                <!-- Cuerpo del Formulario -->
                <div class="card-body p-4 p-md-5">
                    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form", @class = "needs-validation" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                        <!-- Campo Email -->
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })
                            <div class="input-group">
                                <span class="input-group-text text-muted"><i class="fa-solid fa-envelope"></i></span>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-with-icon", @placeholder = "ejemplo@correo.com" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Campo Contraseña -->
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold" })
                            <div class="input-group">
                                <span class="input-group-text text-muted"><i class="fa-solid fa-lock"></i></span>
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control form-control-with-icon", @placeholder = "••••••••" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Recordarme -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input", @id = "rememberCheck" })
                                <label class="form-check-label text-secondary small" for="rememberCheck">
                                    Recordarme en este equipo
                                </label>
                            </div>
                        </div>

                        <!-- Botón de Iniciar Sesión -->
                        <div class="d-grid gap-2 mb-4">
                            <button type="submit" class="btn btn-login shadow-sm">
                                <i class="fa-solid fa-right-to-bracket me-2"></i>Iniciar Sesión
                            </button>
                        </div>

                        <!-- Enlace de Registro -->
                        <div class="text-center pt-3 border-top">
                            <span class="text-muted small">¿Aún no tienes cuenta?</span> <br />
                            @Html.ActionLink("Registrarse como asociado nuevo", "Register", "Account", null, new { @class = "fw-bold text-decoration-none text-primary" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
