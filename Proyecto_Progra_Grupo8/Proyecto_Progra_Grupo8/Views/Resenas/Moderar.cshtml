@model IEnumerable<Proyecto_Progra_Grupo8.Entidades.Models.Resena>

@{
    ViewBag.Title = "Moderar reseñas";
}

<div class="container mt-4">

    <h2>Moderación de reseñas</h2>
    <p class="text-muted">
        Apruebe o rechace las reseñas enviadas por los asociados.
    </p>

    <hr />

    <div id="moderarSinPendientes"
         class="alert alert-info @(Model != null && Model.Any() ? "d-none" : "")">
        No hay reseñas pendientes de moderación.
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered align-middle"
                   id="tablaResenas">

                <thead class="table-dark">
                    <tr>
                        <th>Evento</th>
                        <th>Asociado</th>
                        <th>Comentario</th>
                        <th>Fecha</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr id="fila-resena-@item.ResenaId">

                            <td>
                                @if (item.Evento != null)
                                {
                                    @item.Evento.Nombre
                                }
                            </td>

                            <td>
                                @if (item.Usuario != null)
                                {
                                    @item.Usuario.NombreCompleto
                                }
                            </td>

                            <td>
                                @item.Comentario
                            </td>

                            <td>
                                @item.FechaResena.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td class="text-center">

                                <div class="d-flex justify-content-center gap-2">

                                    <button type="button"
                                            class="btn btn-success btn-sm btn-aprobar-resena"
                                            data-resena-id="@item.ResenaId">
                                        <span class="spinner-border spinner-border-sm d-none"
                                              role="status"></span>
                                        Aprobar
                                    </button>

                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalRechazar-@item.ResenaId">
                                        Rechazar
                                    </button>

                                </div>

                                <div class="modal fade"
                                     id="modalRechazar-@item.ResenaId"
                                     tabindex="-1"
                                     aria-hidden="true">

                                    <div class="modal-dialog">

                                        <div class="modal-content">

                                            <div class="modal-header">

                                                <h5 class="modal-title">
                                                    Rechazar reseña
                                                </h5>

                                                <button type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="modal"
                                                        aria-label="Cerrar">
                                                </button>

                                            </div>

                                            <div class="modal-body text-start">

                                                <p>
                                                    ¿Está seguro de que desea rechazar esta reseña?
                                                </p>

                                                <div class="alert alert-light border">
                                                    @item.Comentario
                                                </div>

                                            </div>

                                            <div class="modal-footer">

                                                <button type="button"
                                                        class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                    Cancelar
                                                </button>

                                                <button type="button"
                                                        class="btn btn-danger btn-rechazar-resena"
                                                        data-resena-id="@item.ResenaId">
                                                    <span class="spinner-border spinner-border-sm d-none"
                                                          role="status"></span>
                                                    Sí, rechazar
                                                </button>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <div class="mt-3">

        @Html.ActionLink(
                 "Volver al panel",
                 "Panel",
                 "Home",
                 null,
                 new
                 {
                     @class = "btn btn-secondary"
                 })

    </div>

</div>

@section scripts {
    <script src="~/Scripts/app/moderar-resenas.js"></script>
}
