@model IEnumerable<Proyecto_Progra_Grupo8.Entidades.Models.Resena>

@{
    ViewBag.Title = "Mis reseñas";
}

<div class="container mt-4">

    <h2>Mis reseñas</h2>
    <hr />

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Todavía no ha enviado ninguna reseña.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Evento</th>
                        <th>Comentario</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @if (item.Evento != null)
                                {
                                    @item.Evento.Nombre
                                }
                            </td>

                            <td>
                                @item.Comentario
                            </td>

                            <td>
                                @item.FechaResena.ToString("dd/MM/yyyy hh:mm tt")
                            </td>

                            <td>
                                @if (item.Estado == "Aprobada")
                                {
                                    <span class="badge bg-success">
                                        Aprobada
                                    </span>
                                }
                                else if (item.Estado == "Rechazada")
                                {
                                    <span class="badge bg-danger">
                                        Rechazada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pendiente
                                    </span>
                                }
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <div class="mt-3">
        @Html.ActionLink(
            "Volver al panel",
            "Panel",
            "Home",
            null,
            new
            {
                @class = "btn btn-secondary"
            })
    </div>

</div>
