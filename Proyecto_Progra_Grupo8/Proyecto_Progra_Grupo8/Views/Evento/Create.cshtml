@model Proyecto_Progra_Grupo8.ViewModels.EventoViewModel

@{
    ViewBag.Title = "Crear Nuevo Evento";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Asegúrate de que el layout apunte a tu plantilla principal
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2 class="mb-4 text-primary">Crear Nuevo Evento</h2>
            <hr />

            @using (Html.BeginForm("Create", "Evento", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

 <!-- CÓDIGO Y NOMBRE -->
            <div class="row">
                <div class="col-md-4 mb-3">
                    @Html.LabelFor(model => model.Evento.CodigoEvento, htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.Evento.CodigoEvento, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej: CONC-01" } })
                    @Html.ValidationMessageFor(model => model.Evento.CodigoEvento, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-8 mb-3">
                    @Html.LabelFor(model => model.Evento.Nombre, htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.Evento.Nombre, new { htmlAttributes = new { @class = "form-control", placeholder = "Nombre del evento" } })
                    @Html.ValidationMessageFor(model => model.Evento.Nombre, "", new { @class = "text-danger" })
                </div>
            </div>

 <!-- DESCRIPCIÓN -->
            <div class="mb-3">
                @Html.LabelFor(model => model.Evento.Descripcion, htmlAttributes: new { @class = "form-label fw-bold" })
                @Html.EditorFor(model => model.Evento.Descripcion, new { htmlAttributes = new { @class = "form-control", rows = 3 } })
                @Html.ValidationMessageFor(model => model.Evento.Descripcion, "", new { @class = "text-danger" })
            </div>

 <!-- CATEGORÍA Y FECHA -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Evento.CategoriaEventoId, htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.Evento.CategoriaEventoId, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Evento.CategoriaEventoId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Evento.FechaHora, htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.Evento.FechaHora, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                    @Html.ValidationMessageFor(model => model.Evento.FechaHora, "", new { @class = "text-danger" })
                </div>
            </div>

 <!-- LUGAR Y PRECIO -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Evento.Lugar, htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.Evento.Lugar, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Evento.Lugar, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Evento.PrecioEntrada, htmlAttributes: new { @class = "form-label fw-bold" })
                    <div class="input-group">
                        <span class="input-group-text">₡</span>
                        @Html.EditorFor(model => model.Evento.PrecioEntrada, new { htmlAttributes = new { @class = "form-control", type = "number", step = "0.01" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Evento.PrecioEntrada, "", new { @class = "text-danger" })
                </div>
            </div>

 <!-- AFORO Y DISPONIBILIDAD -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Evento.AforoTotal, htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.Evento.AforoTotal, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                    @Html.ValidationMessageFor(model => model.Evento.AforoTotal, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Evento.EntradasDisponibles, htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.Evento.EntradasDisponibles, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                    @Html.ValidationMessageFor(model => model.Evento.EntradasDisponibles, "", new { @class = "text-danger" })
                </div>
            </div>

 <!-- ESTADO ACTIVO -->
            <div class="mb-4 form-check form-switch">
                @Html.CheckBoxFor(model => model.Evento.Activo, new { @class = "form-check-input", id = "flexSwitchCheckChecked", @checked = "checked" })
                @Html.LabelFor(model => model.Evento.Activo, htmlAttributes: new { @class = "form-check-label fw-bold", @for = "flexSwitchCheckChecked" })
            </div>

 <!-- SECCIÓN DE IMÁGENES -->
            <div class="card bg-light mb-4 shadow-sm border-0">
                <div class="card-body">
                    @Html.LabelFor(model => model.ArchivosImagenes, htmlAttributes: new { @class = "form-label fw-bold text-primary" })
                    <p class="text-muted small mb-2"><i class="bi bi-info-circle"></i> Seleccione al menos 3 imágenes. (Formatos soportados: JPG, PNG)</p>

                    <!-- Input tipo file con atributo multiple -->
                    <input type="file" name="ArchivosImagenes" id="ArchivosImagenes" class="form-control" multiple accept="image/jpeg, image/png" required />
                </div>
            </div>

 <!-- BOTONES DE ACCIÓN -->
            <div class="d-flex justify-content-end gap-2 mb-5">
                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
                <button type="submit" class="btn btn-success px-4">Guardar Evento</button>
            </div>
            }
        </div>
    </div>
</div>