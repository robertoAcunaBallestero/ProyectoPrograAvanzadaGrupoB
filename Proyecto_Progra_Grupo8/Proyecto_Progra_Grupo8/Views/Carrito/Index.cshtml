@model IList<Proyecto_Progra_Grupo8.Models.CarritoItemViewModel>

@{
    ViewBag.Title = "Carrito";
    var total = Model.Sum(x => x.Subtotal);
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h1>Carrito de compras</h1>
        <p class="text-muted">
            Revise sus entradas antes de confirmar la compra.
        </p>
    </div>

    @*@if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">
                @TempData["MensajeExito"]
            </div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">
                @TempData["MensajeError"]
            </div>
        }*@

    @Html.Partial("_Mensajes")

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            Su carrito está vacío.
        </div>

        <div class="text-center">
            @Html.ActionLink(
                     "Ir a la cartelera",
                     "Index",
                     "Cartelera",
                     null,
                     new { @class = "btn btn-primary" }
                 )
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead>
                    <tr>
                        <th>Evento</th>
                        <th>Precio</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <strong>@item.Nombre</strong>
                            </td>

                            <td>
                                ₡@item.Precio.ToString("N2")
                            </td>

                            <td>

                                @using (Html.BeginForm(
                                    "Actualizar",
                                    "Carrito",
                                    FormMethod.Post,
                                    new { @class = "d-flex gap-2" }))
                                {
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="eventoId"
                                           value="@item.EventoId" />

                                    <input type="number"
                                           name="cantidad"
                                           value="@item.Cantidad"
                                           min="1"
                                           max="@item.Disponibles"
                                           class="form-control"
                                           style="width: 90px"
                                           required />

                                    <button type="submit"
                                            class="btn btn-outline-primary btn-sm">
                                        Actualizar
                                    </button>
                                }

                            </td>

                            <td>
                                ₡@item.Subtotal.ToString("N2")
                            </td>

                            <td>

                                @using (Html.BeginForm(
                                    "Eliminar",
                                    "Carrito",
                                    FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="eventoId"
                                           value="@item.EventoId" />

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">
                                        Eliminar
                                    </button>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="text-end mt-4">

            <h3>
                Total:
                ₡@total.ToString("N2")
            </h3>

            <button type="button"
                    class="btn btn-success btn-lg"
                    data-bs-toggle="modal"
                    data-bs-target="#modalConfirmarCompra">
                Confirmar compra
            </button>

        </div>

        <div class="modal fade" id="modalConfirmarCompra" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Confirmar compra</h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body">
                        <p>
                            ¿Desea confirmar la compra por un total de
                            <strong>₡@total.ToString("N2")</strong>?
                        </p>
                        <p class="text-muted mb-0">
                            Se generarán los tickets correspondientes a sus entradas.
                        </p>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="button"
                                class="btn btn-success"
                                id="btnConfirmarCompra">
                            <span class="spinner-border spinner-border-sm d-none"
                                  role="status"></span>
                            Sí, confirmar compra
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <div class="mt-3">

            @Html.ActionLink(
                     "Seguir comprando",
                     "Index",
                     "Cartelera",
                     null,
                     new { @class = "btn btn-secondary" }
                 )

        </div>
    }

</div>

@section scripts {
    <script src="~/Scripts/app/carrito.js"></script>
}


