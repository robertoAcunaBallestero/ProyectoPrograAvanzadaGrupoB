@model IEnumerable<Proyecto_Progra_Grupo8.Entidades.Models.Evento>

@using System.Linq

@{
    ViewBag.Title = "Administración de eventos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2>Administración de eventos</h2>

            <p class="text-muted mb-0">
                Gestión de los eventos registrados en el sistema.
            </p>
        </div>

        @Html.ActionLink(
            "Crear evento",
            "Create",
            "Eventos",
            null,
            new
            {
                @class = "btn btn-primary"
            })

    </div>

    <hr />

    @Html.Partial("_Mensajes")

    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Eventos activos
                    </h6>

                    <h3 class="mb-0">
                        @ViewBag.TotalEventosActivos
                    </h3>

                </div>

            </div>

        </div>

    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay eventos registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered align-middle">

                <thead class="table-dark">

                    <tr>
                        <th>Código</th>
                        <th>Evento</th>
                        <th>Categoría</th>
                        <th>Fecha</th>
                        <th>Lugar</th>
                        <th>Precio</th>
                        <th>Aforo</th>
                        <th>Disponibles</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var evento in Model)
                    {
                        <tr>

                            <td>
                                @evento.CodigoEvento
                            </td>

                            <td>
                                @evento.Nombre
                            </td>

                            <td>
                                @if (evento.CategoriaEvento != null)
                                {
                                    @evento.CategoriaEvento.Nombre
                                }
                            </td>

                            <td>
                                @evento.FechaHora.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @evento.Lugar
                            </td>

                            <td>
                                ₡@evento.PrecioEntrada.ToString("N2")
                            </td>

                            <td class="text-center">
                                @evento.AforoTotal
                            </td>

                            <td class="text-center">
                                @evento.EntradasDisponibles
                            </td>

                            <td class="text-center">

                                @if (evento.Activo)
                                {
                                    <span class="badge bg-success">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactivo
                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <div class="d-flex justify-content-center gap-1">

                                    @Html.ActionLink(
                                        "Detalle",
                                        "Details",
                                        "Eventos",
                                        new
                                        {
                                            id = evento.EventoId
                                        },
                                        new
                                        {
                                            @class = "btn btn-info btn-sm text-white"
                                        })

                                    @Html.ActionLink(
                                        "Editar",
                                        "Edit",
                                        "Eventos",
                                        new
                                        {
                                            id = evento.EventoId
                                        },
                                        new
                                        {
                                            @class = "btn btn-warning btn-sm"
                                        })

                                    @if (evento.Activo)
                                    {
                                        @Html.ActionLink(
                                            "Desactivar",
                                            "Desactivar",
                                            "Eventos",
                                            new
                                            {
                                                id = evento.EventoId
                                            },
                                            new
                                            {
                                                @class = "btn btn-danger btn-sm"
                                            })
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <div class="mt-3">

        @Html.ActionLink(
            "Volver al panel",
            "Panel",
            "Home",
            null,
            new
            {
                @class = "btn btn-secondary"
            })

    </div>

</div>
