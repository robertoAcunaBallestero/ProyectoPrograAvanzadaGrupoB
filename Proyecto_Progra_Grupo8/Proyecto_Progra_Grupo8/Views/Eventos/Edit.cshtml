@model Proyecto_Progra_Grupo8.ViewModels.EventoViewModel

@{
    ViewBag.Title = "Editar Evento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <div class="row">

        <div class="col-md-8 offset-md-2">

            <h2 class="mb-4 text-primary">
                Editar Evento
            </h2>

            <hr />

            @using (Html.BeginForm(
                "Edit",
                "Eventos",
                FormMethod.Post,
                new
                {
                    enctype = "multipart/form-data"
                }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(
                         model => model.Evento.EventoId)

                @Html.ValidationSummary(
                         true,
                         "",
                         new
                         {
                             @class = "alert alert-danger"
                         })

                <!-- CÓDIGO Y NOMBRE -->
                <div class="row">

                    <div class="col-md-4 mb-3">

                        @Html.LabelFor(
                                 model => model.Evento.CodigoEvento,
                                 new
                                 {
                                     @class = "form-label fw-bold"
                                 })

                        @Html.EditorFor(
                                 model => model.Evento.CodigoEvento,
                                 new
                                 {
                                     htmlAttributes = new
                                     {
                                         @class = "form-control"
                                     }
                                 })

                        @Html.ValidationMessageFor(
                                 model => model.Evento.CodigoEvento,
                                 "",
                                 new
                                 {
                                     @class = "text-danger"
                                 })

                    </div>

                    <div class="col-md-8 mb-3">

                        @Html.LabelFor(
                                 model => model.Evento.Nombre,
                                 new
                                 {
                                     @class = "form-label fw-bold"
                                 })

                        @Html.EditorFor(
                                 model => model.Evento.Nombre,
                                 new
                                 {
                                     htmlAttributes = new
                                     {
                                         @class = "form-control"
                                     }
                                 })

                        @Html.ValidationMessageFor(
                                 model => model.Evento.Nombre,
                                 "",
                                 new
                                 {
                                     @class = "text-danger"
                                 })

                    </div>

                </div>

                <!-- DESCRIPCIÓN -->
                <div class="mb-3">

                    @Html.LabelFor(
                             model => model.Evento.Descripcion,
                             new
                             {
                                 @class = "form-label fw-bold"
                             })

                    @Html.TextAreaFor(
                             model => model.Evento.Descripcion,
                             new
                             {
                                 @class = "form-control",
                                 rows = "4"
                             })

                    @Html.ValidationMessageFor(
                             model => model.Evento.Descripcion,
                             "",
                             new
                             {
                                 @class = "text-danger"
                             })

                </div>

                <!-- CATEGORÍA Y FECHA -->
                <div class="row">

                    <div class="col-md-6 mb-3">

                        @Html.LabelFor(
                                 model => model.Evento.CategoriaEventoId,
                                 new
                                 {
                                     @class = "form-label fw-bold"
                                 })

                        @Html.EditorFor(
                                 model => model.Evento.CategoriaEventoId,
                                 new
                                 {
                                     htmlAttributes = new
                                     {
                                         @class = "form-control",
                                         type = "number",
                                         min = "1"
                                     }
                                 })

                        @Html.ValidationMessageFor(
                                 model => model.Evento.CategoriaEventoId,
                                 "",
                                 new
                                 {
                                     @class = "text-danger"
                                 })

                    </div>

                    <div class="col-md-6 mb-3">

                        @Html.LabelFor(
                                 model => model.Evento.FechaHora,
                                 new
                                 {
                                     @class = "form-label fw-bold"
                                 })

                        @Html.TextBoxFor(
                                 model => model.Evento.FechaHora,
                                 "{0:yyyy-MM-ddTHH:mm}",
                                 new
                                 {
                                     @class = "form-control",
                                     type = "datetime-local"
                                 })

                        @Html.ValidationMessageFor(
                                 model => model.Evento.FechaHora,
                                 "",
                                 new
                                 {
                                     @class = "text-danger"
                                 })

                    </div>

                </div>

                <!-- LUGAR Y PRECIO -->
                <div class="row">

                    <div class="col-md-6 mb-3">

                        @Html.LabelFor(
                                 model => model.Evento.Lugar,
                                 new
                                 {
                                     @class = "form-label fw-bold"
                                 })

                        @Html.EditorFor(
                                 model => model.Evento.Lugar,
                                 new
                                 {
                                     htmlAttributes = new
                                     {
                                         @class = "form-control"
                                     }
                                 })

                        @Html.ValidationMessageFor(
                                 model => model.Evento.Lugar,
                                 "",
                                 new
                                 {
                                     @class = "text-danger"
                                 })

                    </div>

                    <div class="col-md-6 mb-3">

                        @Html.LabelFor(
                                 model => model.Evento.PrecioEntrada,
                                 new
                                 {
                                     @class = "form-label fw-bold"
                                 })

                        <div class="input-group">

                            <span class="input-group-text">
                                ₡
                            </span>

                            @Html.EditorFor(
                                     model => model.Evento.PrecioEntrada,
                                     new
                                     {
                                         htmlAttributes = new
                                         {
                                             @class = "form-control",
                                             type = "number",
                                             step = "0.01",
                                             min = "0"
                                         }
                                     })

                        </div>

                        @Html.ValidationMessageFor(
                                 model => model.Evento.PrecioEntrada,
                                 "",
                                 new
                                 {
                                     @class = "text-danger"
                                 })

                    </div>

                </div>

                <!-- AFORO -->
                <div class="row">

                    <div class="col-md-6 mb-3">

                        @Html.LabelFor(
                                 model => model.Evento.AforoTotal,
                                 new
                                 {
                                     @class = "form-label fw-bold"
                                 })

                        @Html.EditorFor(
                                 model => model.Evento.AforoTotal,
                                 new
                                 {
                                     htmlAttributes = new
                                     {
                                         @class = "form-control",
                                         type = "number",
                                         min = "1"
                                     }
                                 })

                        @Html.ValidationMessageFor(
                                 model => model.Evento.AforoTotal,
                                 "",
                                 new
                                 {
                                     @class = "text-danger"
                                 })

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Entradas disponibles
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.Evento.EntradasDisponibles"
                               readonly />

                        <div class="form-text">
                            Se calcula automáticamente según las entradas vendidas.
                        </div>

                    </div>

                </div>

                <!-- ESTADO -->
                <div class="mb-4">

                    <div class="form-check">

                        @Html.CheckBoxFor(
                                 model => model.Evento.Activo,
                                 new
                                 {
                                     @class = "form-check-input"
                                 })

                        @Html.LabelFor(
                                 model => model.Evento.Activo,
                                 new
                                 {
                                     @class = "form-check-label fw-bold"
                                 })

                    </div>

                </div>

                <!-- IMÁGENES ACTUALES -->
                if (Model.Evento.Imagenes != null &&
                    Model.Evento.Imagenes.Any())
                {
                    <div class="card mb-4">

                        <div class="card-header">
                            Imágenes actuales
                        </div>

                        <div class="card-body">

                            <div class="row g-3">

                                @foreach (var imagen in Model.Evento.Imagenes)
                                {
                                    <div class="col-md-4">

                                        <img src="@Url.Action(
                                            "Imagen",
                                            "Eventos",
                                            new { id = imagen.ImagenEventoId })"
                                             class="img-fluid rounded border"
                                             style="height: 150px; width: 100%; object-fit: cover;"
                                             alt="@Model.Evento.Nombre" />

                                    </div>
                                }

                            </div>

                        </div>

                    </div>
                }

                <!-- NUEVAS IMÁGENES -->
                <div class="card bg-light mb-4 shadow-sm border-0">

                    <div class="card-body">

                        @Html.LabelFor(
                                 model => model.ArchivosImagenes,
                                 new
                                 {
                                     @class = "form-label fw-bold text-primary"
                                 })

                        <p class="text-muted small mb-2">
                            Puede agregar nuevas imágenes al evento.
                            Si no desea agregar imágenes, deje este campo vacío.
                        </p>

                        <input type="file"
                               name="ArchivosImagenes"
                               id="ArchivosImagenes"
                               class="form-control"
                               multiple
                               accept="image/jpeg,image/png" />

                    </div>

                </div>

                <!-- BOTONES -->
                <div class="d-flex justify-content-end gap-2 mb-5">

                    @Html.ActionLink(
                             "Cancelar",
                             "Index",
                             "Eventos",
                             null,
                             new
                             {
                                 @class = "btn btn-secondary"
                             })

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Guardar cambios
                    </button>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/app/eventos.js"></script>
}
